DATABASE_URL=postgres://opsagent:opsagent@localhost:5432/opsagent
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-32-bytes-of-random
CAPABILITY_SECRET=replace-with-32-bytes-of-random
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=cn=svc-opsagent,ou=services,dc=example,dc=com
LDAP_BIND_PASSWORD=replace-me
LDAP_BASE_DN=ou=people,dc=example,dc=com
LOCAL_ADMIN_ENABLED=true
LOCAL_ADMIN_USER=breakglass
LOCAL_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$replace-me
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=opsagent
MINIO_SECRET_KEY=opsagent-local

# PKI
OPSAGENT_CRL_URL=http://127.0.0.1:8080/api/pki/crl
OPSAGENT_OCSP_URL=http://127.0.0.1:8080/api/pki/ocsp

# Traffic canary is configured per deployment in the Web console;
# the generated Nginx config must be applied by the ingress. No extra env is required.

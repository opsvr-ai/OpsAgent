# Build-time settings used by `docker compose build`.
# 内网把 NPM_REGISTRY 指向 Nexus/Artifactory 的 npm 代理。
NPM_REGISTRY=https://registry.npmjs.org
# 内网 Go 模块代理；没有代理时需要在有网环境构建镜像，或使用预编译二进制。
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org

# 控制面日志
LOG_LEVEL=info
OPSAGENT_LOG_REQUESTS=true

# 控制面对 Agent 的访问地址。必须是 Agent 所在主机能访问的宿主机 IP/域名，
# 不能使用 127.0.0.1（Agent 会把 127.0.0.1 当成它自己）。
OPSAGENT_PUBLIC_URL=http://192.168.1.100:8080
OPSAGENT_AGENT_ENROLLMENT_TOKEN=replace-with-enrollment-token
OPSAGENT_CRL_URL=http://192.168.1.100:8080/api/pki/crl
OPSAGENT_OCSP_URL=http://192.168.1.100:8080/api/pki/ocsp
OPSAGENT_TLS_HOSTNAMES=localhost,opsagent-control
OPSAGENT_TLS_IPS=127.0.0.1

# 本地管理员（seed 时写入数据库）
LOCAL_ADMIN_ENABLED=true
LOCAL_ADMIN_USERNAME=tenant-admin
LOCAL_ADMIN_USERNAMES=tenant-admin,platform-admin
LOCAL_ADMIN_PASSWORD=replace-me
OPSAGENT_SECRET_KEY=replace-with-32-bytes-of-random

# 容器镜像已内置 /opt/opsagent-agent-dist；仅非容器/自定义目录时覆盖。
# OPSAGENT_AGENT_DIST_DIR=/opt/opsagent-agent-dist

# 宿主机直跑工具使用的连接串；compose 内部使用 postgres/redis 服务名。
DATABASE_URL=postgres://opsagent:opsagent@localhost:5432/opsagent
REDIS_URL=redis://localhost:6379

# LDAP（可选）
LDAP_URL=ldap://localhost:389
LDAP_BIND_DN=cn=svc-opsagent,ou=services,dc=example,dc=com
LDAP_BIND_PASSWORD=replace-me
LDAP_BASE_DN=ou=people,dc=example,dc=com

# MinIO（可选）
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=opsagent
MINIO_SECRET_KEY=opsagent-local

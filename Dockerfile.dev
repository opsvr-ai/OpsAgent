# Development image for the OpsAgent control plane.
# Uses the locally available Node 22 Alpine image; production should pin Node 24.
# The source tree is bind-mounted by compose; node_modules stay in anonymous
# volumes so Windows/macOS hosts never install Linux-native modules.
FROM node:22-alpine

RUN apk add --no-cache python3 make g++ bash \
  && npm install -g pnpm@11.4.0 @deepseek-ai/dsh@0.2.1-rc.5

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/control/package.json apps/control/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json

RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 8080 5173

CMD ["pnpm", "--filter", "@opsagent/control", "exec", "tsx", "watch", "src/index.ts"]

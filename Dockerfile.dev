# Development image for the OpsAgent control plane.
# Uses the locally available Node 22 Alpine image; production should pin Node 24.
# The source tree is bind-mounted by compose; node_modules stay in anonymous
# volumes so Windows/macOS hosts never install Linux-native modules.
ARG NPM_REGISTRY=https://registry.npmjs.org
ARG GOPROXY=https://proxy.golang.org,direct
ARG GOSUMDB=sum.golang.org

FROM golang:1.26-alpine AS agent-dist

ARG GOPROXY
ARG GOSUMDB
ENV GOPROXY=$GOPROXY
ENV GOSUMDB=$GOSUMDB

WORKDIR /src
COPY agents/opsagent-agent/go.mod agents/opsagent-agent/go.sum ./
RUN go mod download
COPY agents/opsagent-agent/ ./
RUN mkdir -p /out \
  && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -o /out/opsagent-agent-linux-amd64 . \
  && CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -trimpath -o /out/opsagent-agent-linux-arm64 . \
  && CGO_ENABLED=0 GOOS=windows GOARCH=amd64 go build -trimpath -o /out/opsagent-agent-windows-amd64.exe .

FROM node:22-alpine

ARG NPM_REGISTRY
ENV NPM_CONFIG_REGISTRY=$NPM_REGISTRY

RUN npm config set registry "$NPM_REGISTRY" \
  && apk add --no-cache python3 make g++ bash \
  && npm install -g pnpm@11.4.0 @deepseek-ai/dsh@0.2.1-rc.5

WORKDIR /app

# Ship agent binaries outside /app so a compose bind mount of the source tree
# cannot hide them. The control plane reads this directory by default.
COPY --from=agent-dist /out /opt/opsagent-agent-dist

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/control/package.json apps/control/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json

RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 8080 5173

CMD ["pnpm", "--filter", "@opsagent/control", "exec", "tsx", "watch", "src/index.ts"]
